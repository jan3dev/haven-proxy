# Your Haven API key (starts with hvn1_). Purchase one via POST /api/v1/haven/purchase/
# then submit payment via POST /api/v1/haven/purchase/submit/ to receive it.
# This is the only place the secret lives — never put it in opencode.json.
HAVEN_API_KEY=hvn1_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional environment variables

# Origin of the Ankara backend that serves the Haven API (no trailing path).
# Defaults to the production Ankara instance. Override for staging/local dev.
# Must be HTTPS — the SDK refuses to fetch the attestation bundle over plaintext.
#HAVEN_BASE_URL=https://ankara.aquabtc.com

# Where the proxy listens (HTTP proxy only). Keep it bound to localhost: the endpoint
# is unauthenticated and relays with your funded key. Binding to a non-loopback
# host is refused unless you set HAVEN_ALLOW_REMOTE=1 (open relay — your risk).
#HOST=127.0.0.1
#PORT=3301

# Comma-separated model ids exposed via GET /v1/models (HTTP proxy only — not
# used by the in-process OpenCode provider, which declares models in opencode.json).
# Must match model ids the enclave actually serves.
# Available on Haven: gpt-oss-120b, kimi-k2-6, glm-5-2, gemma4-31b, llama3-3-70b, qwen3-vl-30b
#HAVEN_MODELS=gpt-oss-120b,kimi-k2-6,glm-5-2,gemma4-31b,llama3-3-70b,qwen3-vl-30b

# Per-request upstream deadline in milliseconds (default 300000 = 5 min).
# Responses are buffered — long generations legitimately take minutes — but a
# hung enclave call is cut off at this deadline (HTTP 504) so it can't hang
# forever.
#HAVEN_TIMEOUT_MS=300000
